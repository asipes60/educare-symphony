# Local development only. In production these are pulled from GCP Secret Manager.
# Copy to .env and fill in real values for local testing.

ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
AIRTABLE_API_KEY=patxxxxxxxxxxxxxxxxxx

# Drive auth uses Application Default Credentials. For local runs:
#   gcloud auth application-default login
# That writes credentials to ~/.config/gcloud/application_default_credentials.json
# which the Drive client picks up automatically. No env var needed.

# Set to "local" to skip GCP Secret Manager and read directly from this .env file.
SYMPHONY_ENV=local
